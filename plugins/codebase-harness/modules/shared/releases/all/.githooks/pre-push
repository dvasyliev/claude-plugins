#!/usr/bin/env sh
# Runs each executable step in .githooks/pre-push.d/ (one per module, in name order),
# then the project's own .githooks/pre-push.local. A failing step cancels the push.
# Every step gets the same arguments, and the refs being pushed on stdin:
# one "<local ref> <local sha> <remote ref> <remote sha>" per line.
refs=$(cat)

for step in $(LC_ALL=C ls .githooks/pre-push.d 2>/dev/null); do
	step=".githooks/pre-push.d/$step"
	[ -f "$step" ] && [ -x "$step" ] || continue
	printf '%s\n' "$refs" | "$step" "$@" || exit 1
done

# The project's own pre-push steps, which the harness never writes or overwrites.
if [ -x .githooks/pre-push.local ]; then
	printf '%s\n' "$refs" | .githooks/pre-push.local "$@" || exit 1
fi
exit 0
