#!/usr/bin/env sh
# The playwright step of .githooks/pre-push: runs the end-to-end tests.
# Way out for a human: SKIP_VERIFY=1 git push skips this step only
[ -n "$SKIP_VERIFY" ] && { echo "pre-push: skipped via SKIP_VERIFY" >&2; exit 0; }

# The refs being pushed, one "<local ref> <local sha> <remote ref> <remote sha>" per line.
refs=$(cat)

# Skip the tests when every commit pushed holds exactly the code that last
# passed the whole suite (.githooks/verify.sh keeps it in .git/e2e-green).
green=$(cat "$(git rev-parse --git-dir)/e2e-green" 2>/dev/null)
same=false
if [ -n "$green" ] && [ -n "$refs" ]; then
	same=true
	while read -r _ sha _ _; do
		# A deleted branch pushes no code.
		[ "$sha" = 0000000000000000000000000000000000000000 ] && continue
		[ "$(git rev-parse "$sha^{tree}" 2>/dev/null)" = "$green" ] && continue
		# With `releases`: a release commit only raises the version and adds to the
		# changelog, so it counts as green when its parent holds the code that passed.
		if git log -1 --format=%s "$sha" 2>/dev/null | grep -Eq '^chore(\(.*\))?: release v[0-9]' &&
			[ "$(git rev-parse "$sha^^{tree}" 2>/dev/null)" = "$green" ]; then
			continue
		fi
		same=false
	done <<EOT
$refs
EOT
fi

if $same; then
	echo "pre-push: this code already passed npm run verify; skipping it"
else
	# Run the end-to-end tests. If they fail, the push is cancelled.
	# On macOS caffeinate keeps the Mac awake: a Mac that sleeps fails random tests.
	echo "pre-push: running npm run verify"
	if [ -f pnpm-lock.yaml ]; then pm=pnpm; else pm=npm; fi
	if command -v caffeinate >/dev/null 2>&1; then
		caffeinate -dims "$pm" run -s verify || exit 1
	else
		"$pm" run -s verify || exit 1
	fi
fi
exit 0
